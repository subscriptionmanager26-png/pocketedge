{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/og-image.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    },
    {
      "source": "/og-image.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/markets/(.*)-preview.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/markets/(indices|commodities)(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/markets/(.*)-search.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/markets/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/asset-logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=86400, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "social.pocketedge.in" }],
      "destination": "https://www.pocketedge.in/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.pocketedge.in" },
        { "type": "query", "key": "ucits", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?ucits=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.pocketedge.in" },
        { "type": "query", "key": "leaderboard", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?leaderboard=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.pocketedge.in" },
        { "type": "query", "key": "legal", "value": "(?<legal>.*)" }
      ],
      "destination": "https://global.pocketedge.in/?legal=:legal",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pocketedge.in" },
        { "type": "query", "key": "ucits", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?ucits=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pocketedge.in" },
        { "type": "query", "key": "leaderboard", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?leaderboard=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pocketedge.in" },
        { "type": "query", "key": "legal", "value": "(?<legal>.*)" }
      ],
      "destination": "https://global.pocketedge.in/?legal=:legal",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
