{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/dispatch-github/asset-sync",
      "schedule": "30 2 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://eu.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://eu.i.posthog.com https://*.posthog.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.supabase.co https://accounts.google.com"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/markets",
      "headers": [
        {
          "key": "Link",
          "value": "</data/markets/stocks-preview.json>; rel=preload; as=fetch"
        }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    },
    {
      "source": "/og-image.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/markets/(.*)-preview.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=14400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/markets/(indices|commodities)(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/markets/(.*)-search.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/markets/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/screener/screener-snapshot-meta.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/screener/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/market-quotes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=10, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/data/etf-inav/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/data/sgb/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/asset-logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/learning",
      "destination": "/business-model",
      "permanent": true
    },
    {
      "source": "/learning/:symbol",
      "destination": "/business-model/:symbol",
      "permanent": true
    },
    {
      "source": "/gold-tracker",
      "destination": "/resources/sgb",
      "permanent": true
    },
    {
      "source": "/etf-tracker",
      "destination": "/resources/etf-inav",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.saffronai.in" }],
      "destination": "https://www.pocketedge.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "saffronai.in" }],
      "destination": "https://www.pocketedge.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "social.pocketedge.in" }],
      "destination": "https://www.pocketedge.in/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.pocketedge.in" },
        { "type": "query", "key": "ucits", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?ucits=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.pocketedge.in" },
        { "type": "query", "key": "leaderboard", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?leaderboard=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.pocketedge.in" },
        { "type": "query", "key": "legal", "value": "(?<legal>.*)" }
      ],
      "destination": "https://global.pocketedge.in/?legal=:legal",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pocketedge.in" },
        { "type": "query", "key": "ucits", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?ucits=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pocketedge.in" },
        { "type": "query", "key": "leaderboard", "value": "1" }
      ],
      "destination": "https://global.pocketedge.in/?leaderboard=1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pocketedge.in" },
        { "type": "query", "key": "legal", "value": "(?<legal>.*)" }
      ],
      "destination": "https://global.pocketedge.in/?legal=:legal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/asset-logos/:path*",
      "destination": "https://zweqxjeuwwfrlpbuuayg.supabase.co/storage/v1/object/public/asset-logos/:path*"
    },
    {
      "source": "/share/portfolio/:id",
      "destination": "/api/share/portfolio/:id"
    },
    {
      "source": "/stock/:symbol",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|twitterbot|linkedinbot|slackbot|whatsapp|telegrambot|discordbot|applebot).*"
        }
      ],
      "destination": "/api/seo/stock/:symbol"
    },
    {
      "source": "/etf/:symbol",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|twitterbot|linkedinbot|slackbot|whatsapp|telegrambot|discordbot|applebot).*"
        }
      ],
      "destination": "/api/seo/etf/:symbol"
    },
    {
      "source": "/fund/:schemeCode",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|duckduckbot|yandex|baiduspider|facebookexternalhit|twitterbot|linkedinbot|slackbot|whatsapp|telegrambot|discordbot|applebot).*"
        }
      ],
      "destination": "/api/seo/fund/:schemeCode"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|asset-logos/).*)", "destination": "/index.html" }
  ]
}
